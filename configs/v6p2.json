{
  "_meta": {
    "title": "v6p2 train+infer (easy-to-hard 300ep, infer short/mid/long runs=5, hybrid/shielded, default gating)",
    "date": "2026-02-18",
    "summary": "Training uses random start/goal with a distance curriculum (easy→hard) for 300 episodes. Inference evaluates short/mid/long suites with random pairs (5 each) under hybrid/shielded regime, leaving gating params at defaults.",
    "commands": [
      "conda run -n ros2py310 python train.py --profile v6p2",
      "conda run -n ros2py310 python infer.py --profile v6p2"
    ],
    "notes": [
      "Inference uses random-pair sampling (not fixed pairs). If you want fixed pairs per suite, run three separate infer profiles or extend infer to accept per-suite pair files.",
      "Mid suite uses rand_min_dist_m/rand_max_dist_m = 14–42m; short/long suites use rand_short_* / rand_long_* overrides."
    ]
  },
  "train": {
    "envs": [
      "forest_a"
    ],
    "out": "v6p2",
    "rl_algos": [
      "cnn-ddqn"
    ],
    "episodes": 300,
    "max_steps": 1200,
    "forest_random_start_goal": true,
    "forest_curriculum": true,
    "curriculum_ramp": 1.0,
    "forest_rand_min_dist_m": 6.0,
    "forest_rand_max_dist_m": 0.0,
    "forest_rand_edge_margin_m": 3.0,
    "forest_rand_fixed_prob": 0.0,
    "forest_rand_tries": 200,
    "forest_action_delta_dot_bins": 15,
    "forest_action_accel_bins": 15,
    "save_ckpt": "auto",
    "device": "cuda",
    "cuda_device": 0,
    "seed": 0,
    "progress": true
  },
  "infer": {
    "envs": [
      "forest_a::short",
      "forest_a::mid",
      "forest_a::long"
    ],
    "models": "v6p2",
    "out": "v6p2",
    "rl_algos": [
      "cnn-ddqn"
    ],
    "baselines": [
      "hybrid_astar_mpc"
    ],
    "baseline_timeout": 60.0,
    "random_start_goal": true,
    "runs": 5,
    "progress": true,
    "forest_no_fallback": false,
    "forest_action_delta_dot_bins": 15,
    "forest_action_accel_bins": 15,
    "rand_min_dist_m": 14.0,
    "rand_max_dist_m": 42.0,
    "rand_short_min_dist_m": 6.0,
    "rand_short_max_dist_m": 14.0,
    "rand_long_min_dist_m": 42.0,
    "rand_long_max_dist_m": 0.0,
    "rand_edge_margin_m": 3.0,
    "rand_reject_unreachable": true,
    "rand_reject_policy": "none",
    "rand_tries": 400,
    "max_steps": 1200,
    "no_terminate_on_stuck": true,
    "goal_tolerance_m": 1.0,
    "goal_angle_tolerance_deg": 180.0,
    "goal_stop_speed_m_s": 0.1,
    "goal_stop_delta_deg": 3.0,
    "kpi_time_mode": "policy",
    "device": "auto",
    "cuda_device": 0,
    "seed": 33,
    "forest_goal_admissible_relax_factor": 1.5
  }
}

