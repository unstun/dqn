    "forest_reward_k_t": 0.1,
    "forest_reward_k_delta": 0.8,
    "forest_reward_no_progress_penalty": 0.35,
    "forest_reward_no_progress_eps_m": 0.03,
    "forest_reward_idle_speed_m_s": 0.12,
    "forest_demo_filter_min_progress_ratio": 0.05,
