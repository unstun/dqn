{
  "_meta": {
    "title": "v6p4 train+infer (cnn-ddqn schedule-fix + weaker demo prior)",
    "date": "2026-02-20",
    "summary": "Align epsilon/PER schedule with actual episode budget, reduce demo dominance, and increase map resolution.",
    "commands": [
      "conda run -n ros2py310 python train.py --profile v6p4",
      "conda run -n ros2py310 python infer.py --profile v6p4"
    ],
    "notes": [
      "RL scope in this version remains cnn-ddqn only.",
      "Baseline scope remains Hybrid A*-MPC for apples-to-apples comparison.",
      "Main fixes target epsilon schedule, DQfD regularization strength, and observation resolution."
    ]
  },
  "train": {
    "envs": [
      "forest_a"
    ],
    "out": "v6p4",
    "rl_algos": [
      "cnn-ddqn"
    ],
    "demo_mode": "dqfd",
    "episodes": 3000,
    "max_steps": 1200,
    "gamma": 0.997,
    "learning_rate": 0.0001,
    "batch_size": 128,
    "target_update_steps": 2000,
    "target_update_tau": 0.0,
    "grad_clip_norm": 10.0,
    "eps_start": 1.0,
    "eps_final": 0.05,
    "eps_decay": 0,
    "eps_decay_ratio": 0.67,
    "hidden_layers": 3,
    "hidden_dim": 256,
    "dqfd_n_step": 10,
    "dqfd_lambda_n": 0.5,
    "dqfd_l2": 0.00001,
    "per_alpha": 0.4,
    "per_beta0": 0.6,
    "per_beta_steps": 900000,
    "per_eps_agent": 0.001,
    "per_eps_demo": 3.0,
    "demo_lambda": 1.5,
    "demo_margin": 0.8,
    "forest_expert": "hybrid_astar_mpc",
    "forest_astar_opt_enable": false,
