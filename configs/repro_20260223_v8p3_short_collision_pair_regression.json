{
  "_meta": {
    "title": "v8p3 regression (short collision pair from v8p2 smoke)",
    "date": "2026-02-23",
    "summary": "Infer-only regression on the short collision sample observed in v8p2 smoke. Uses fixed (start,goal) from `configs/pairs_v8p2_short_collision_run2.json` to verify the collision-first fallback fix eliminates the reproducible collision on `forest_a::short`.",
    "commands": [
      "conda run -n ros2py310 python infer.py --profile repro_20260223_v8p3_short_collision_pair_regression"
    ]
  },
  "infer": {
    "envs": [
      "forest_a::short"
    ],
    "models": "v8p2_costmap_smoke",
    "out": "v8p3_short_collision_pair_regression",
    "rl_algos": [
      "cnn-ddqn"
    ],
    "baselines": [],
    "baseline_timeout": 60.0,
    "random_start_goal": true,
    "rand_pairs_json": "configs/pairs_v8p2_short_collision_run2.json",
    "runs": 1,
    "progress": true,
    "forest_no_fallback": false,
    "forest_adm_horizon": 30,
    "forest_topk": 10,
    "forest_min_progress_m": 0.01,
    "forest_progress_dist_mode": "dijkstra8_nocorner",
    "forest_progress_cost_w_clearance": 2.0,
    "forest_progress_cost_sigma_m": 0.5,
    "forest_min_od_m": 0.02,
    "forest_action_delta_dot_bins": 15,
    "forest_action_accel_bins": 15,
    "rand_min_dist_m": 14.0,
    "rand_max_dist_m": 42.0,
    "rand_short_min_dist_m": 6.0,
    "rand_short_max_dist_m": 14.0,
    "rand_long_min_dist_m": 42.0,
    "rand_long_max_dist_m": 0.0,
    "rand_edge_margin_m": 3.0,
    "rand_reject_unreachable": true,
    "rand_reject_policy": "none",
    "rand_tries": 400,
    "max_steps": 1200,
    "no_terminate_on_stuck": true,
    "goal_tolerance_m": 1.0,
    "goal_angle_tolerance_deg": 180.0,
    "goal_stop_speed_m_s": 0.1,
    "goal_stop_delta_deg": 3.0,
    "kpi_time_mode": "policy",
    "device": "auto",
    "cuda_device": 0,
    "seed": 33
  }
}

