{
  "_meta": {
    "title": "v8p9 infer sweep smoke (short, runs=3, fixed pairs3 subset from pairs20)",
    "date": "2026-02-24",
    "summary": "Inference-first sweep smoke for v8p9 on forest_a::short. Uses fixed pairs3 (subset of pairs20) to avoid sample drift. Models are pinned to an existing training run (v8p8 smoke) to isolate inference-side effects.",
    "commands": [
      "conda run -n ros2py310 python infer.py --profile repro_20260224_v8p9_infer_sweep_short_smoke",
      "conda run -n ros2py310 python infer.py --profile repro_20260224_v8p9_infer_sweep_short_smoke --forest-min-progress-m 0.01",
      "conda run -n ros2py310 python infer.py --profile repro_20260224_v8p9_infer_sweep_short_smoke --forest-min-od-m 0.0",
      "conda run -n ros2py310 python infer.py --profile repro_20260224_v8p9_infer_sweep_short_smoke --forest-topk-turn-penalty 0.0"
    ],
    "notes": [
      "Anti-cheating: do NOT change goal_tolerance_m (and do not loosen stop thresholds) for evaluation.",
      "This is screening only; final gate uses pairs20 with runs=20."
    ]
  },
  "infer": {
    "envs": [
      "forest_a::short"
    ],
    "models": "runs/v8p8_dueling_globalcnn_aux_smoke/train_20260224_105059",
    "out": "v8p9_infer_sweep_short_pairs3_smoke",
    "rl_algos": [
      "cnn-ddqn"
    ],
    "baselines": [
      "hybrid_astar_mpc"
    ],
    "baseline_timeout": 60.0,
    "random_start_goal": true,
    "rand_pairs_json": "configs/pairs_v8p9_smoke_short3_from_pairs20_v1_20260224.json",
    "runs": 3,
    "progress": true,
    "forest_no_fallback": false,
    "forest_adm_horizon": 30,
    "forest_goal_admissible_relax_factor": 2.5,
    "forest_topk": 10,
    "forest_topk_turn_penalty": 0.2,
    "forest_replace_ranking": "progress_clearance_q",
    "forest_replace_topq": 1,
    "forest_min_progress_m": 0.02,
    "forest_min_od_m": 0.02,
    "forest_goal_approach_override": true,
    "forest_goal_approach_dist_m": 0.0,
    "forest_goal_approach_speed_factor": 1.0,
    "forest_action_delta_dot_bins": 15,
    "forest_action_accel_bins": 15,
    "max_steps": 1200,
    "no_terminate_on_stuck": true,
    "goal_tolerance_m": 1.0,
    "goal_angle_tolerance_deg": 180.0,
    "goal_stop_speed_m_s": 0.1,
    "goal_stop_delta_deg": 3.0,
    "kpi_time_mode": "policy",
    "device": "auto",
    "cuda_device": 0,
    "seed": 123
  }
}

